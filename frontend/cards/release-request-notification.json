{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "Container",
      "style": "Accent",
      "bleed": true,
      "items": [
        {
          "type": "TextBlock",
          "text": "🔔 Release approval requested",
          "weight": "Bolder",
          "size": "Medium",
          "wrap": true
        },
        {
          "type": "TextBlock",
          "text": "Sales order ${salesOrderNumber}",
          "size": "Small",
          "isSubtle": true,
          "spacing": "None",
          "wrap": true
        }
      ]
    },
    {
      "type": "Container",
      "spacing": "Medium",
      "items": [
        {
          "type": "FactSet",
          "facts": [
            {
              "title": "Requested by",
              "value": "${requestedBy}"
            },
            {
              "title": "Sales organization",
              "value": "${salesOrg}"
            },
            {
              "title": "Net value",
              "value": "${formattedNetValue}"
            },
            {
              "title": "Requested at",
              "value": "${requestedAt}"
            }
          ]
        },
        {
          "type": "TextBlock",
          "text": "**Note:** ${comment}",
          "wrap": true,
          "spacing": "Small",
          "$when": "${comment != ''}"
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Action.Submit",
      "title": "View details",
      "data": {
        "msteams": {
          "type": "messageBack",
          "displayText": "View order ${salesOrderNumber}",
          "text": "view order ${salesOrderNumber}"
        },
        "action": "view_details",
        "salesOrderId": "${salesOrderNumber}"
      }
    },
    {
      "type": "Action.Submit",
      "title": "Approve",
      "style": "positive",
      "data": {
        "msteams": {
          "type": "messageBack",
          "displayText": "Approve order ${salesOrderNumber}",
          "text": "approve order ${salesOrderNumber}"
        },
        "action": "approve_so",
        "salesOrderId": "${salesOrderNumber}"
      }
    },
    {
      "type": "Action.Submit",
      "title": "Reject",
      "style": "destructive",
      "data": {
        "msteams": {
          "type": "messageBack",
          "displayText": "Reject approval ${salesOrderNumber}",
          "text": "reject approval ${salesOrderNumber}"
        },
        "action": "reject_approval",
        "salesOrderId": "${salesOrderNumber}"
      }
    }
  ]
}
