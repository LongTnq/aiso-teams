{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "Container",
      "style": "Attention",
      "bleed": true,
      "items": [
        {
          "type": "TextBlock",
          "text": "❌ Release request declined",
          "weight": "Bolder",
          "size": "Medium",
          "wrap": true
        },
        {
          "type": "TextBlock",
          "text": "Sales order ${salesOrderNumber}",
          "size": "Small",
          "isSubtle": true,
          "spacing": "None",
          "wrap": true
        }
      ]
    },
    {
      "type": "Container",
      "spacing": "Medium",
      "items": [
        {
          "type": "FactSet",
          "facts": [
            {
              "title": "Declined by",
              "value": "${declinedBy}"
            },
            {
              "title": "Sales organization",
              "value": "${salesOrg}"
            },
            {
              "title": "Net value",
              "value": "${formattedNetValue}"
            },
            {
              "title": "Declined at",
              "value": "${declinedAt}"
            }
          ]
        },
        {
          "type": "TextBlock",
          "text": "**Reason:** ${comment}",
          "wrap": true,
          "spacing": "Small",
          "color": "Attention"
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Action.Submit",
      "title": "View details",
      "data": {
        "msteams": {
          "type": "messageBack",
          "displayText": "View order ${salesOrderNumber}",
          "text": "view order ${salesOrderNumber}"
        },
        "action": "view_details",
        "salesOrderId": "${salesOrderNumber}"
      }
    }
  ]
}
